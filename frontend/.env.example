# Configuração de Ambiente para o New News Frontend
# Renomeie para .env ou .env.local para personalizar suas variáveis de ambiente localmente.

# Define se deve utilizar o adaptador de MOCK (true) ou a API real do backend (false)
VITE_USE_MOCK=true

# URL base da API REST do backend (utilizada apenas quando VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:3000/api

# Simulação de latência de rede em milissegundos para o Mock Adapter (0 para desativar)
VITE_MOCK_DELAY_MS=250
