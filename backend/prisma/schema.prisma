generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
}

model Category {
    id    String @id @default(uuid())
    name  String @unique
    label String
    icon  String

    news News[]

    @@map("categories")
}

model News {
    id           String   @id @default(uuid())
    category_id  String
    title        String
    description  String
    url          String   @unique
    author       String
    image_url    String
    language     String
    source       String
    published_at DateTime

    category Category @relation(fields: [category_id], references: [id])

    @@map("news")
}
